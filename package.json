{
  "name": "dustyui",
  "version": "1.0.2",
  "description": "A minimalist, neutral-toned React UI component library styled with CSS Modules.",
  "keywords": [
    "react",
    "ui",
    "design-system",
    "component-library",
    "css-modules",
    "dustyui"
  ],
  "author": "Wioletta Gluza <wiolagluza@gmail.com> (https://wiola.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/w-gluza/dustyui"
  },
  "homepage": "https://github.com/w-gluza/dustyui",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cpy \"**/*.css\" ../dist --cwd=src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format:check": "prettier --check ."
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "type": "module",
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/styles/tokens.css",
    "./package.json": "./package.json"
  }
}
