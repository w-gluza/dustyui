{
  "name": "dustyui",
  "version": "3.0.0",
  "description": "A minimalist, neutral-toned React UI component library styled with CSS Modules.",
  "keywords": [
    "react",
    "ui",
    "design-system",
    "component-library",
    "css-modules",
    "dustyui"
  ],
  "author": "Wioletta Gluza <wiolagluza@gmail.com> (https://wiola.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/w-gluza/dustyui"
  },
  "homepage": "https://github.com/w-gluza/dustyui",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cpy \"**/*.css\" \"**/*.d.css.ts\" ../dist --cwd=src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumer": "node scripts/check-consumer.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^5.1.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "type": "module",
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./tokens.css": "./dist/styles/tokens.css",
    "./themes/*.css": "./dist/styles/themes/*.css"
  },
  "sideEffects": [
    "./dist/index.js",
    "**/*.css"
  ],
  "peerDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
